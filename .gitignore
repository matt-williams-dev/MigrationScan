# Build output
bin/
obj/
[Bb]uild/
artifacts/

# ...except inside test fixtures, where a build-output directory is the thing under test:
# discovery must be proven to skip it, and it cannot be if it is not in the repository.
!tests/fixtures/**/bin/
!tests/fixtures/**/obj/

# .NET tool / test artifacts
*.nupkg
TestResults/
coverage*.json
*.trx

# Verify (golden-file test) received files awaiting approval
*.received.*

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.suo

# OS
.DS_Store
Thumbs.db

# The tool writes this into the working directory on a default run. Scanning this repo
# while developing should not offer to commit its own output.
migrationscan-report.json
