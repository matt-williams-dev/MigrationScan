<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Packaged and distributed as a global dotnet tool. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrationscan</ToolCommandName>
    <AssemblyName>migrationscan</AssemblyName>
    <PackageId>MigrationScan.Tool</PackageId>
    <Title>MigrationScan</Title>
    <!-- One line on purpose: MSBuild preserves the indentation of a wrapped value and it ends up
         in the .nuspec, where some clients render it verbatim. -->
    <Description>A free, deterministic, offline .NET Framework migration assessment tool. It answers one question: how much work is it to move this solution off .NET Framework, and what specifically blocks it? Runs offline, produces the same output every time, requires no account, and never transmits your source code. Every finding carries a confidence tier, and a single scan reports both staying on Windows and going cross-platform.</Description>
    <PackageTags>dotnet-framework;migration;upgrade;assessment;roslyn;analysis;modernization;sarif;legacy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/matt-williams-dev/MigrationScan/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Symbols alongside the package. Cheap, and the alternative is being unable to diagnose
         a report a customer says is wrong. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Settings for the self-contained single-file builds published on the releases page.
    They only take effect when a RuntimeIdentifier is passed (the release workflow does);
    an ordinary `dotnet build` and the NuGet tool package are unaffected.

    This is the build a customer actually runs. The teams with the largest .NET Framework
    estates are exactly the ones who cannot install a .NET 10 SDK on a locked-down build
    server, so requiring one to assess their estate would rule them out before they start.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Roslyn is loaded reflectively in places; trimming it is not worth the risk of a
         scan failing on a customer machine we cannot debug. Size is not the constraint. -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Deterministic output matters here too: two people publishing the same tag should get
         the same binary, so a customer can verify what they were sent. -->
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <!-- Referenced projects would otherwise drop their .pdb next to the executable, so the
         "single file" would arrive as three. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MigrationScan.Core\MigrationScan.Core.csproj" />
    <ProjectReference Include="..\MigrationScan.Reporting\MigrationScan.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MigrationScan.Tool.Tests" />
  </ItemGroup>

</Project>
