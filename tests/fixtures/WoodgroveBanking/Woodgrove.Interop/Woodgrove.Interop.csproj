<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B1000003-0000-0000-0000-000000000003}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Woodgrove.Interop</RootNamespace>
    <AssemblyName>Woodgrove.Interop</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Configuration" />
    <!-- WMI (MIG4003). -->
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <!-- Cheque scanner driver exposed as a COM type library (MIG1006). -->
    <COMReference Include="FabrikamImagingLib">
      <Guid>{7c2f4a10-0000-0000-0000-0000000000a1}</Guid>
      <VersionMajor>3</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Vendor SDK checked into the repository. No NuGet package exists for it, and the vendor
         shipped no source, so the migration path needs research rather than an upgrade (MIG1010). -->
    <Reference Include="Litware.ChequeScanner, Version=3.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>libs\Litware.ChequeScanner.dll</HintPath>
    </Reference>
    <!-- Restored from the NuGet cache — an ordinary package, not vendored. -->
    <Reference Include="Proseware.Json">
      <HintPath>..\packages\Proseware.Json.9.1.2\lib\net45\Proseware.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="TerminalProfile.cs" />
    <Compile Include="BranchHostInventory.cs" />
    <Compile Include="ChequeScannerInterop.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
