<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="DefaultAccount" value="00000000" />
    <add key="StatementArchivePath" value="D:\Archive" />
  </appSettings>
  <connectionStrings>
    <add name="WoodgroveLedger"
         connectionString="Data Source=ledger-db;Initial Catalog=WoodgroveLedger;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <authentication mode="Windows" />
  </system.web>
</configuration>
