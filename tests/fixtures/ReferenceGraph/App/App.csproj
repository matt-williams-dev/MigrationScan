<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>App</RootNamespace>
    <AssemblyName>App</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework assembly: read, but excluded from the third-party inventory. -->
    <Reference Include="System.Web" />
    <!-- Third-party, GAC-resolved (no HintPath). -->
    <Reference Include="Telerik.Web.UI, Version=2015.3.930.45, Culture=neutral, PublicKeyToken=121fae78165ba3d4" />
    <!-- Vendored: checked-in DLL, no package behind it. -->
    <Reference Include="Contoso.Payments, Version=2.1.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\libs\Contoso.Payments.dll</HintPath>
    </Reference>
    <!-- Restored from packages.config — declared there, so not duplicated as an assembly. -->
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed">
      <HintPath>..\packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- Installed as a package but resolving from the GAC (no HintPath) — one component, not
         two. packages.config wins; the GAC resolution is MIG1005's business, not inventory. -->
    <Reference Include="Contoso.Grid, Version=4.5.0.0, Culture=neutral, PublicKeyToken=99881122aabbccdd" />
    <!-- ActiveX host wrapper generated by aximp — COM, not a plain assembly. -->
    <Reference Include="AxInterop.MSCommLib, Version=1.0.0.0, Culture=neutral">
      <HintPath>..\libs\AxInterop.MSCommLib.dll</HintPath>
    </Reference>
    <!-- Embedded primary interop assembly — also COM. -->
    <Reference Include="Microsoft.Office.Interop.Excel, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c">
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- COM type library imported by tlbimp. -->
    <COMReference Include="MSXML2">
      <Guid>{f5078f18-c551-11d3-89b9-0000f81fe221}</Guid>
      <VersionMajor>6</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <WrapperTool>tlbimp</WrapperTool>
    </COMReference>
    <!-- COM type library referenced as a file on disk. -->
    <COMFileReference Include="..\libs\ScannerCtl.tlb" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy ASMX web reference. -->
    <WebReferenceUrl Include="http://pricing.internal/Legacy.asmx">
      <RelPath>Web References\LegacyPricing\</RelPath>
      <UrlBehavior>Dynamic</UrlBehavior>
    </WebReferenceUrl>
    <!-- WCF service reference; the endpoint lives in the .svcmap. -->
    <None Include="Service References\PricingService\Reference.svcmap" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj">
      <Project>{11111111-2222-3333-4444-555555555555}</Project>
      <Name>Shared</Name>
    </ProjectReference>
  </ItemGroup>
</Project>
